--!strict
local ui = script.Parent:WaitForChild("UI", 10)
assert(ui, "StarterPlayerScripts.UI missing")
local tools = script.Parent:WaitForChild("Tools", 10)
assert(tools, "StarterPlayerScripts.Tools missing")
local menuModule = ui:WaitForChild("SpawnMenu", 10)
assert(menuModule and menuModule:IsA("ModuleScript"), "SpawnMenu module missing")
local controllerModule = tools:WaitForChild("ToolController", 10)
assert(controllerModule and controllerModule:IsA("ModuleScript"), "ToolController module missing")
local selectModule = ui:WaitForChild("WeaponSelect", 10)
assert(selectModule and selectModule:IsA("ModuleScript"), "WeaponSelect module missing")
local ragdollModule = script.Parent:WaitForChild("Ragdoll", 10)
assert(ragdollModule and ragdollModule:IsA("ModuleScript"), "Ragdoll module missing")
local firstPersonModule = script.Parent:WaitForChild("FirstPerson", 10)
assert(firstPersonModule and firstPersonModule:IsA("ModuleScript"), "FirstPerson module missing")
require(menuModule).init()
require(selectModule).init()
require(ragdollModule).init()
require(firstPersonModule).init()
require(controllerModule).init()
