--!strict
-- Wait for the first full copy of the game. Modules index ReplicatedStorage.Shared directly when required, and
-- PlayerScripts can start before it has all arrived ("WeaponCatalog is not a valid member of Shared").
if not game:IsLoaded() then
	game.Loaded:Wait()
end
local ui = script.Parent:WaitForChild("UI", 10)
assert(ui, "StarterPlayerScripts.UI missing")
local tools = script.Parent:WaitForChild("Tools", 10)
assert(tools, "StarterPlayerScripts.Tools missing")
local menuModule = ui:WaitForChild("SpawnMenu", 10)
assert(menuModule and menuModule:IsA("ModuleScript"), "SpawnMenu module missing")
local controllerModule = tools:WaitForChild("ToolController", 10)
assert(controllerModule and controllerModule:IsA("ModuleScript"), "ToolController module missing")
local selectModule = ui:WaitForChild("WeaponSelect", 10)
assert(selectModule and selectModule:IsA("ModuleScript"), "WeaponSelect module missing")
local ragdollModule = script.Parent:WaitForChild("Ragdoll", 10)
assert(ragdollModule and ragdollModule:IsA("ModuleScript"), "Ragdoll module missing")
local firstPersonModule = script.Parent:WaitForChild("FirstPerson", 10)
assert(firstPersonModule and firstPersonModule:IsA("ModuleScript"), "FirstPerson module missing")
local mainMenuModule = ui:WaitForChild("MainMenu", 10)
assert(mainMenuModule and mainMenuModule:IsA("ModuleScript"), "MainMenu module missing")
local keyboardLookModule = script.Parent:WaitForChild("KeyboardLook", 10)
assert(keyboardLookModule and keyboardLookModule:IsA("ModuleScript"), "KeyboardLook module missing")
local gunPoseModule = script.Parent:WaitForChild("GunPose", 10)
assert(gunPoseModule and gunPoseModule:IsA("ModuleScript"), "GunPose module missing")
local flashlightModule = script.Parent:WaitForChild("Flashlight", 10)
assert(flashlightModule and flashlightModule:IsA("ModuleScript"), "Flashlight module missing")
local mirrorModule = script.Parent:WaitForChild("Mirror", 10)
assert(mirrorModule and mirrorModule:IsA("ModuleScript"), "Mirror module missing")
local thirdPersonModule = script.Parent:WaitForChild("ThirdPerson", 10)
assert(thirdPersonModule and thirdPersonModule:IsA("ModuleScript"), "ThirdPerson module missing")
local mapLightingModule = script.Parent:WaitForChild("MapLighting", 10)
assert(mapLightingModule and mapLightingModule:IsA("ModuleScript"), "MapLighting module missing")
local npcVoiceModule = script.Parent:WaitForChild("NpcVoice", 10)
assert(npcVoiceModule and npcVoiceModule:IsA("ModuleScript"), "NpcVoice module missing")
require(menuModule).init()
require(selectModule).init()
require(ragdollModule).init()
require(firstPersonModule).init()
require(controllerModule).init()
require(keyboardLookModule).init()
require(gunPoseModule).init()
require(flashlightModule).init()
require(mirrorModule).init()
require(thirdPersonModule).init()
require(mapLightingModule).init()
require(npcVoiceModule).init()
require(mainMenuModule).init()
