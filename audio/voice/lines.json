{
  "npcs": {
    "guest": {
      "name": "Guest",
      "voice": "Classic Guest 1337: excited little kid, talks fast, a bit lost, thinks it's still 2016. Higher and brighter than your normal voice.",
      "pitch": 0
    },
    "noob": {
      "name": "Noob",
      "voice": "Yellow noob: slow, dopey, super confident he's a pro. Big goofy smile in the voice, a bit nasal.",
      "pitch": 0
    },
    "johndoe": {
      "name": "John Doe",
      "voice": "Regular friendly guy, the default avatar from 2006. Close to your normal voice: relaxed, polite, like a chill neighbor. A bit plain on purpose, that's the joke.",
      "pitch": 0
    }
  },
  "lines": [
    {"id": "guest_spawn_1", "npc": "guest", "category": "spawn", "text": "Hi! Is this the obby?", "note": ""},
    {"id": "guest_spawn_2", "npc": "guest", "category": "spawn", "text": "Whoa. Where am I?", "note": "just loaded in, amazed"},
    {"id": "guest_idle_1", "npc": "guest", "category": "idle", "text": "Why can't I chat?", "note": "confused, to himself"},
    {"id": "guest_idle_2", "npc": "guest", "category": "idle", "text": "Can I have admin? Please?", "note": ""},
    {"id": "guest_idle_3", "npc": "guest", "category": "idle", "text": "I've been a guest for nine years.", "note": "proud"},
    {"id": "guest_idle_4", "npc": "guest", "category": "idle", "text": "How do I make a game?", "note": ""},
    {"id": "guest_idle_5", "npc": "guest", "category": "idle", "text": "Is this game free?", "note": ""},
    {"id": "guest_greet_1", "npc": "guest", "category": "greet", "text": "Hi! Hi! Hiii!", "note": "waving, too excited"},
    {"id": "guest_greet_2", "npc": "guest", "category": "greet", "text": "Wanna be friends? Oh wait, I can't add friends.", "note": "happy, then sad"},
    {"id": "guest_greet_3", "npc": "guest", "category": "greet", "text": "Cool avatar! Mine's the default one.", "note": ""},
    {"id": "guest_follow_1", "npc": "guest", "category": "follow", "text": "Okay, I'll follow you!", "note": ""},
    {"id": "guest_follow_2", "npc": "guest", "category": "follow", "text": "Wait for me!", "note": "running, a bit out of breath"},
    {"id": "guest_stay_1", "npc": "guest", "category": "stay", "text": "Okay, I'll wait here. Forever, probably.", "note": ""},
    {"id": "guest_grabbed_1", "npc": "guest", "category": "grabbed", "text": "Hey! Put me down!", "note": ""},
    {"id": "guest_grabbed_2", "npc": "guest", "category": "grabbed", "text": "Whoa, I can fly!", "note": "delighted"},
    {"id": "guest_thrown_1", "npc": "guest", "category": "thrown", "text": "Wheeeee!", "note": "long, fading"},
    {"id": "guest_thrown_2", "npc": "guest", "category": "thrown", "text": "Aaaaaaah!", "note": "scream, 2 seconds"},
    {"id": "guest_hurt_1", "npc": "guest", "category": "hurt", "text": "Ow!", "note": "short"},
    {"id": "guest_hurt_2", "npc": "guest", "category": "hurt", "text": "Hey, that hurt!", "note": ""},
    {"id": "guest_hurt_3", "npc": "guest", "category": "hurt", "text": "Why would you do that?", "note": "about to cry"},
    {"id": "guest_death_1", "npc": "guest", "category": "death", "text": "Oof!", "note": "your own oof, don't copy the old Roblox sound"},
    {"id": "guest_death_2", "npc": "guest", "category": "death", "text": "Nooo, I didn't save!", "note": ""},
    {"id": "guest_flee_1", "npc": "guest", "category": "flee", "text": "Run! Run!", "note": "panicked"},
    {"id": "guest_flee_2", "npc": "guest", "category": "flee", "text": "I don't wanna get banned!", "note": ""},
    {"id": "noob_spawn_1", "npc": "noob", "category": "spawn", "text": "The noob has arrived.", "note": "announcing himself"},
    {"id": "noob_spawn_2", "npc": "noob", "category": "spawn", "text": "Don't worry, I'm a pro.", "note": ""},
    {"id": "noob_idle_1", "npc": "noob", "category": "idle", "text": "How do you jump?", "note": ""},
    {"id": "noob_idle_2", "npc": "noob", "category": "idle", "text": "My dad works at Roblox.", "note": "lying, very sure of it"},
    {"id": "noob_idle_3", "npc": "noob", "category": "idle", "text": "I'm not a noob. I'm just yellow.", "note": "offended"},
    {"id": "noob_idle_4", "npc": "noob", "category": "idle", "text": "This avatar cost zero Robux. Zero!", "note": "proud"},
    {"id": "noob_idle_5", "npc": "noob", "category": "idle", "text": "Has anyone seen my obby?", "note": ""},
    {"id": "noob_greet_1", "npc": "noob", "category": "greet", "text": "Hello, fellow noob!", "note": ""},
    {"id": "noob_greet_2", "npc": "noob", "category": "greet", "text": "Wanna see a trick? ... I fell.", "note": "pause, then disappointed"},
    {"id": "noob_follow_1", "npc": "noob", "category": "follow", "text": "Coming! Coming!", "note": ""},
    {"id": "noob_follow_2", "npc": "noob", "category": "follow", "text": "Follow the leader! Wait, you're the leader.", "note": "realizes halfway"},
    {"id": "noob_stay_1", "npc": "noob", "category": "stay", "text": "Standing very still. Like a pro.", "note": "whispering, concentrating"},
    {"id": "noob_grabbed_1", "npc": "noob", "category": "grabbed", "text": "Is this a glitch?", "note": ""},
    {"id": "noob_grabbed_2", "npc": "noob", "category": "grabbed", "text": "Put me down! I'm telling the admins!", "note": ""},
    {"id": "noob_thrown_1", "npc": "noob", "category": "thrown", "text": "Not agaaaain!", "note": "fading away"},
    {"id": "noob_thrown_2", "npc": "noob", "category": "thrown", "text": "Woo-hoooo!", "note": "actually enjoying it"},
    {"id": "noob_hurt_1", "npc": "noob", "category": "hurt", "text": "Ouch!", "note": ""},
    {"id": "noob_hurt_2", "npc": "noob", "category": "hurt", "text": "That was lag! That didn't count!", "note": ""},
    {"id": "noob_death_1", "npc": "noob", "category": "death", "text": "Oof.", "note": "flat, defeated"},
    {"id": "noob_death_2", "npc": "noob", "category": "death", "text": "Respawning... probably.", "note": ""},
    {"id": "noob_flee_1", "npc": "noob", "category": "flee", "text": "Nope, nope, nope, nope!", "note": "fast"},
    {"id": "johndoe_spawn_1", "npc": "johndoe", "category": "spawn", "text": "Hey. John Doe, nice to meet you.", "note": ""},
    {"id": "johndoe_spawn_2", "npc": "johndoe", "category": "spawn", "text": "Okay, I'm here. What's the plan?", "note": ""},
    {"id": "johndoe_idle_1", "npc": "johndoe", "category": "idle", "text": "Just a normal guy, doing normal guy stuff.", "note": "content"},
    {"id": "johndoe_idle_2", "npc": "johndoe", "category": "idle", "text": "I've had this avatar since 2006.", "note": "proud, but chill"},
    {"id": "johndoe_idle_3", "npc": "johndoe", "category": "idle", "text": "I should really change my shirt.", "note": "looking down at himself"},
    {"id": "johndoe_idle_4", "npc": "johndoe", "category": "idle", "text": "Nice day today. I think. Is there weather here?", "note": ""},
    {"id": "johndoe_idle_5", "npc": "johndoe", "category": "idle", "text": "Anyone seen my sister Jane?", "note": "looking around"},
    {"id": "johndoe_greet_1", "npc": "johndoe", "category": "greet", "text": "Oh, hey there!", "note": "friendly"},
    {"id": "johndoe_greet_2", "npc": "johndoe", "category": "greet", "text": "Hi. I'm John. Just John.", "note": ""},
    {"id": "johndoe_follow_1", "npc": "johndoe", "category": "follow", "text": "Sure, lead the way.", "note": ""},
    {"id": "johndoe_follow_2", "npc": "johndoe", "category": "follow", "text": "Right behind you, buddy.", "note": ""},
    {"id": "johndoe_stay_1", "npc": "johndoe", "category": "stay", "text": "Alright, I'll be right here.", "note": ""},
    {"id": "johndoe_grabbed_1", "npc": "johndoe", "category": "grabbed", "text": "Whoa, whoa, easy!", "note": ""},
    {"id": "johndoe_grabbed_2", "npc": "johndoe", "category": "grabbed", "text": "I'd like my feet on the ground, please.", "note": "polite but nervous"},
    {"id": "johndoe_thrown_1", "npc": "johndoe", "category": "thrown", "text": "Oh nooooo!", "note": "fading"},
    {"id": "johndoe_thrown_2", "npc": "johndoe", "category": "thrown", "text": "Not cool, maaan!", "note": ""},
    {"id": "johndoe_hurt_1", "npc": "johndoe", "category": "hurt", "text": "Ow, hey!", "note": "short"},
    {"id": "johndoe_hurt_2", "npc": "johndoe", "category": "hurt", "text": "Come on, really?", "note": "annoyed"},
    {"id": "johndoe_death_1", "npc": "johndoe", "category": "death", "text": "Oof.", "note": "calm"},
    {"id": "johndoe_death_2", "npc": "johndoe", "category": "death", "text": "Well, that's not ideal.", "note": "flat"},
    {"id": "johndoe_flee_1", "npc": "johndoe", "category": "flee", "text": "Okay, I'm out of here!", "note": ""}
  ]
}
