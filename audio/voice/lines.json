    {"id": "citizen_follow_2", "npc": "citizen", "category": "follow", "text": "Right behind you.", "note": ""},
    {"id": "citizen_stay_1", "npc": "citizen", "category": "stay", "text": "I'll hold this spot.", "note": ""},
    {"id": "citizen_grabbed_1", "npc": "citizen", "category": "grabbed", "text": "Whoa!", "note": "panicked"},
    {"id": "citizen_grabbed_2", "npc": "citizen", "category": "grabbed", "text": "I'm not a crate! Put me down!", "note": ""},
    {"id": "citizen_thrown_1", "npc": "citizen", "category": "thrown", "text": "I hate this cityyyy!", "note": "fading"},
