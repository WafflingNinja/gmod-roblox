    {"id": "rostik_hurt_2", "npc": "rostik", "category": "hurt", "text": "That's not was not in the md files bro!", "note": ""},
    {"id": "rostik_death_1", "npc": "rostik", "category": "death", "text": "Oof.", "note": "panicked"},
