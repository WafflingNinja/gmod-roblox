    {"id": "rostik_idle_5", "npc": "rostik", "category": "idle", "text": "This game took me so many nights, ngl.", "note": "tired, proud"},
    {"id": "rostik_greet_1", "npc": "rostik", "category": "greet", "text": "Yo! Thanks for playing my game!", "note": "hyped"},
    {"id": "rostik_greet_2", "npc": "rostik", "category": "greet", "text": "Oh, a real player! Hey!", "note": "surprised"},
    {"id": "rostik_follow_1", "npc": "rostik", "category": "follow", "text": "Sure, I'll follow you. It's my game, but okay.", "note": ""},
    {"id": "rostik_follow_2", "npc": "rostik", "category": "follow", "text": "Lead the way, I know all the shortcuts anyway.", "note": ""},
