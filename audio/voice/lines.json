    {"id": "citizen_death_1", "npc": "citizen", "category": "death", "text": "Ugh...", "note": "dying groan"},
    {"id": "citizen_death_2", "npc": "citizen", "category": "death", "text": "Tell my cat... I tried.", "note": "weak, dramatic"},
