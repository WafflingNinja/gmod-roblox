    {"id": "rostik_unlock_1", "npc": "rostik", "category": "unlock", "text": "Yo, you found me! Okay, cool", "note": "surprised, then impressed"},
    {"id": "rostik_unlock_2", "npc": "rostik", "category": "unlock", "text": "i didnt expect that", "note": "slow nod in the voice"},
    {"id": "rostik_spawn_1", "npc": "rostik", "category": "spawn", "text": "hey guys", "note": "announcer voice"},
    {"id": "rostik_spawn_2", "npc": "rostik", "category": "spawn", "text": "hey, its me", "note": "casual"},
    {"id": "rostik_idle_1", "npc": "rostik", "category": "idle", "text": "I will be adding loot boxes", "note": "guilty"},
    {"id": "rostik_idle_2", "npc": "rostik", "category": "idle", "text": "is cachyos based on LFS?", "note": ""},
