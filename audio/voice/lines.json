    {"id": "citizen_idle_4", "npc": "citizen", "category": "idle", "text": "Don't look at me.", "note": "dry"},
    {"id": "citizen_idle_5", "npc": "citizen", "category": "idle", "text": "One of these days I'm getting out of this city.", "note": "to himself"},
    {"id": "citizen_greet_1", "npc": "citizen", "category": "greet", "text": "Oh. Hey. You're not one of them, are you?", "note": "suspicious, then relieved"},
